# Optional for local development. Change ALL defaults before deploying publicly.
APP_PORT=8080
POSTGRES_PASSWORD=replace_with_strong_postgres_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
COOKIE_SECURE=false

# Optional: create the first global administrator on startup.
# Use an email that has NOT registered yet. Password: 10+ characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_long_unique_admin_password